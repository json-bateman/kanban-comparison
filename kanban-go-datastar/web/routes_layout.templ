package web 

templ BasePage(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<!-- Sync load main CSS (Tailwind only) -->
			<link href={ StaticPath("style.css") } rel="stylesheet"/>
			<!-- Async load daisyui from CDN -->
			<link href="https://cdn.jsdelivr.net/npm/daisyui@5" type="text/css" rel="stylesheet" media="print" onload="this.media='all'; this.onload=null;" data-ignore-morph/>
			<!-- Async load charts.css from CDN -->
			<link href="https://cdn.jsdelivr.net/npm/charts.css/dist/charts.min.css" rel="stylesheet" media="print" onload="this.media='all'; this.onload=null;" data-ignore-morph/>
			<link href={ StaticPath("favicon.png") } rel="icon" type="image/png"/>
			<title>{ title }</title>
			<script type="module" src={ StaticPath("datastar.js") }></script>
			<!-- Datastar cdn
			<script type="module" src="https://cdn.jsdelivr.net/gh/starfederation/datastar@1.0.0-RC.6/bundles/datastar.js"></script>
            -->
		</head>
		<body>
			{ children... }
		</body>
	</html>
}
